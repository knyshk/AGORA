# Copy to backend/.env and fill in. Never commit backend/.env (it is gitignored).
# All providers below have free tiers.

# LLM providers (at least one key; the fallback chain skips providers without a key)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FALLBACK_CHAIN=groq,gemini,openrouter

# Services (Docker Compose service names; do not use localhost inside Docker)
REDIS_URL=redis://redis:6379
# DATABASE_URL=postgresql+psycopg2://agora:agora@postgres:5432/agora   (this is the default)

# SEC EDGAR requires a contact email in the User-Agent of API requests
SEC_CONTACT_EMAIL=

# Signs login and task tokens. Use a long random string (32+ characters), e.g. from: openssl rand -hex 32
JWT_SECRET=

# Optional
# RUN_BUDGET_USD=0.05        notional per-run budget (economy mode at 80 %, skip at 100 %)
# NODE_TIMEOUT_S=90          per agent call; a timeout reassigns the node
# AGENT_TRANSPORT=mcp        call agents through the MCP server instead of directly
